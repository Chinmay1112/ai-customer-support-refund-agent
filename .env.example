# ==============================================================================
# E-COMMERCE REFUND AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# AI / LLM API Key (Supports OpenAI sk-... or Google Gemini AQ.... keys)
# If left blank, the application automatically runs in deterministic simulation mode
# where all tools, policy validations, and database mutations function seamlessly.
OPENAI_API_KEY=your-api-key-here

# Optional: Google Gemini API key (AQ....) if configured separately
# GEMINI_API_KEY=AQ....

# Configurable Model (Defaults to gemini-flash-latest for Gemini or gpt-4o-mini for OpenAI)
OPENAI_MODEL=gemini-flash-latest

# Optional: Custom OpenAI-compatible Base URL (e.g., https://generativelanguage.googleapis.com/v1beta/openai/)
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# SQLite Database Connection URL
DATABASE_URL="file:./dev.db"

# Node Environment
NODE_ENV=development
